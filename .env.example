# Copy to .env in this same directory, then fill in your details.
# The script auto-loads .env from its own folder (override with ROCCOS_ENV=/path/to/.env).
#
# ROCCOS_HOSTNAME picks the storefront — there is NO default, it must be set here
# (or passed with --site). Accounts are per-location, so credentials must match the
# chosen site. Discover hostnames with:  python3 roccos_locations.py --table
ROCCOS_HOSTNAME=hythe.roccospizza.co.uk
ROCCOS_USER=your.email@example.com
ROCCOS_PASS=
